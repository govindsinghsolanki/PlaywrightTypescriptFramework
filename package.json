    "test_qa_cr_tag": "cross-env ENV_NAME=qa npx playwright test --project=chromium --headed --grep=@Functional",
    "allure-clean":   "rm -rf allure-results allure-report",
    "allure-report":  "npx allure generate allure-results --clean -o allure-report && npx allure open allure-report"
